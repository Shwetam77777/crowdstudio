# Copy this to .env and fill in real values. Never commit .env itself.

PORT=4000
NODE_ENV=development

# Postgres connection string. Local dev example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crowdjam"
DATABASE_URL=

# Generate a strong random secret, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY=7d

# Must match your deployed frontend's origin exactly (no wildcard "*" in production).
CORS_ORIGIN=http://localhost:5173

# --- Optional: real AI export (music rendering) ---
# Leave both blank to disable AI export. The API will return a clear
# 501 "not configured" error instead of faking output when these are unset.
AI_EXPORT_PROVIDER=
AI_EXPORT_API_KEY=
AI_EXPORT_ENDPOINT=
